# Copia este archivo a .env y sustituye los valores. .gitignore deja .env fuera del repositorio.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=diario_gamer
# Render asigna PORT automáticamente; 3001 es solo para desarrollo local.
PORT=3001
# En Render: https://diario-gamer-web-55fd.onrender.com
CORS_ORIGIN=http://localhost:5174
